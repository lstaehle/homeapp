# Telegram
TELEGRAM_BOT_TOKEN=          # Token from @BotFather
TELEGRAM_CHAT_ID_1=          # Your Telegram chat ID (send a message to @userinfobot)
TELEGRAM_CHAT_ID_2=          # Wife's Telegram chat ID

# Google Calendar
GOOGLE_CREDENTIALS_FILE=credentials.json  # OAuth 2.0 Desktop credentials downloaded from Google Cloud Console
GOOGLE_TOKEN_FILE=token.json              # Auto-generated after first OAuth flow; keep this secret
GOOGLE_CALENDAR_ID=                       # Calendar ID of the family calendar (Settings → Integrate calendar → Calendar ID)

# Todoist
TODOIST_API_TOKEN=           # From Todoist → Settings → Integrations → API token
TODOIST_PROJECT_NAME=Einkauf

# LLM calendar parsing
OPENAI_API_KEY=              # API key for natural-language Telegram event creation
OPENAI_MODEL=gpt-4o-mini     # Optional; any OpenAI-compatible chat-completions model
OPENAI_BASE_URL=https://api.openai.com/v1

# Weather (Open-Meteo — free, no API key required)
WEATHER_LAT=46.729          # Latitude of your location
WEATHER_LON=9.443           # Longitude of your location

# App environment (set to "dev" to enable /test-reminder endpoint)
ENV=prod
